OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ALLOWED_ORIGINS=http://localhost:4200
RATE_LIMIT_PER_MIN=20
PORT=5000

# Host login: password the host (and co-hosts) use for the Host Dashboard and to reveal answers.
# CHANGE THIS before the event. Default if unset: funfriday
HOST_PASSWORD=funfriday
# Optional: seconds before an OpenAI call times out (default 40)
# OPENAI_TIMEOUT=40

# Optional per-game models (set to gpt-4o-mini or gpt-4o, or leave unset to use OPENAI_MODEL)
# MODEL_PERSON=gpt-4o-mini
# MODEL_PANIC=gpt-4o-mini
# MODEL_RAPID=gpt-4o-mini
# MODEL_MOVIE=gpt-4o-mini
